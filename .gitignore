# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js build output
/.next/
/out/
/build

# Temporary & Database backup runtime files
/data/backups/*
!/data/backups/.gitkeep
*.tmp
*.temp

# Debug & Error logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
.env*.local
.env

# Vercel CLI
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Operating System files
.DS_Store
Thumbs.db
[Dd]esktop.ini
*.pem

# IDEs and Code Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~
